From 4c9daa9e54d685b816ba96e9a4a5c88d0038729b Mon Sep 17 00:00:00 2001
From: doitwithnotepad <doitwithnotepad@proton.me>
Date: Sat, 9 Nov 2024 14:14:44 +0000
Subject: [PATCH] Explicit support for bitcoind rpc cookie

---
 estimator/index.js                | 1 +
 keys/index-example.js             | 2 ++
 lib/bitcoind-rpc/rpc-client.js    | 1 +
 4 files changed, 6 insertions(+)

diff --git a/estimator/index.js b/estimator/index.js
index 7afd487..10aae00 100644
--- a/estimator/index.js
+++ b/estimator/index.js
@@ -23,6 +23,7 @@ try {
             port: keys.bitcoind.rpc.port,
             username: keys.bitcoind.rpc.user,
             password: keys.bitcoind.rpc.pass,
+            cookie: keys.bitcoind.rpc.cookie_path
         }
     })

diff --git a/keys/index-example.js b/keys/index-example.js
index 1ead8f8..5e8f71e 100644
--- a/keys/index-example.js
+++ b/keys/index-example.js
@@ -27,6 +27,8 @@ export default {
                 user: 'user',
                 // Password
                 pass: 'password',
+                // Cookie path
+                cookie_path: '/path/to/cookie',
                 // IP address
                 host: '127.0.0.1',
                 // TCP port
diff --git a/lib/bitcoind-rpc/rpc-client.js b/lib/bitcoind-rpc/rpc-client.js
index e969860..4fc44af 100644
--- a/lib/bitcoind-rpc/rpc-client.js
+++ b/lib/bitcoind-rpc/rpc-client.js
@@ -29,6 +29,7 @@ export const createRpcClient = (options = {}) => {
         protocol: 'http',
         username: keys.bitcoind.rpc.user,
         password: keys.bitcoind.rpc.pass,
+        cookie: keys.bitcoind.rpc.cookie_path,
         timeout: 2 * 60 * 1000, // 2 minutes
         ...options
     })
--
2.51.0

