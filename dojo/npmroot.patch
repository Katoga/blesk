 lib/bitcoind-rpc/fees.js               | 3 +--
 lib/remote-importer/remote-importer.js | 3 +--
 3 files changed, 3 insertions(+), 6 deletions(-)

diff --git a/lib/auth/auth-rest-api.js b/lib/auth/auth-rest-api.js
index 18a8965..a93d9a6 100644
--- a/lib/auth/auth-rest-api.js
+++ b/lib/auth/auth-rest-api.js
@@ -3,7 +3,6 @@
  * Copyright © 2019 – Katana Cryptographic Ltd. All Rights Reserved.
  */

-import { execSync } from 'child_process'
 import path from 'path'
 import crypto from 'crypto'
 import QuickLRU from 'quick-lru'
@@ -138,7 +137,7 @@ class AuthRestApi {
      */
     async initIpc() {
         try {
-            const NpmRoot = execSync('npm root -g').toString('utf8')
+            const NpmRoot = keys.pm2_node_modules_root || path.join(__dirname, '..', '..', 'node_modules')
             const pm2Module = await import(path.join(NpmRoot, 'pm2', 'index.js'))
             const pm2 = pm2Module.default

